# ---------------------------------------------------------------------------
# Praxis Protocol — orchestrator (/backend/.env)
# Every value has a working default. An empty file runs the whole thing.
# Copy to .env and fill in only what you want to change. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- which ledger --------------------------------------------------------
#   auto       prefer a deployed stack, fall back to the in-process ledger
#   live       require the chain; refuse to start without it
#   simulated  never touch the network
PRAXIS_MODE=auto

# Network key inside ../deployed-addresses.json, written by the deploy script.
PRAXIS_NETWORK=amoy
PRAXIS_RPC_URL=https://rpc-amoy.polygon.technology

# Where the deploy script left the addresses and ABIs. Defaults are correct for
# a normal checkout; set them if you moved things.
# PRAXIS_DEPLOYMENT_FILE=../deployed-addresses.json
# PRAXIS_ABI_DIR=../deployments/abis

# --- signing keys (live mode only) ---------------------------------------
# Three roles, three keys — DisputeSlashing rejects a challenge signed by an
# address authorised to act for the agent it is challenging, so they must differ.
# `cd contracts && npm run wallets:new` generates the agent and challenger keys.
#   ARBITER    resolves disputes (usually the deployer)
#   AGENT      owns the registered agents and signs their attestations
#   CHALLENGER stakes the fee to open a dispute
ARBITER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
CHALLENGER_PRIVATE_KEY=

# --- the brain -----------------------------------------------------------
# With Ollama running, agents reason through the model and the trail records it.
# Without it, they fall back to deterministic rules and the dashboard says so.
PRAXIS_LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3
OLLAMA_TIMEOUT_SECONDS=20

# --- pacing --------------------------------------------------------------
# Seconds between ordinary agent decisions.
PRAXIS_TICK_SECONDS=6.5
# How long the watcher takes to spot a breach and open a dispute.
PRAXIS_WATCHER_DELAY_SECONDS=2.6
# How long the arbiter deliberates before resolving it.
PRAXIS_ARBITER_DELAY_SECONDS=4.2
# Set false to leave every dispute open for a human to resolve from the dashboard.
PRAXIS_AUTO_ARBITRATE=true
# Decisions committed at startup, so the feed is never empty on first paint.
PRAXIS_SEED_ATTESTATIONS=5

# --- economics (simulated mode; a live chain is authoritative) ------------
MIN_BOND=1000
CHALLENGE_FEE=100
CHALLENGE_WINDOW_SECONDS=300
SLASH_BPS=2000
CHALLENGER_REWARD_BPS=5000
# Opening bonds for TradingAgent, DAOVotingAgent, LendingAgent.
PRAXIS_AGENT_BONDS=10000,5000,4000

# --- plumbing ------------------------------------------------------------
# SQLite file holding the revealed decision trails.
# PRAXIS_DB_PATH=./praxis.db
PRAXIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRAXIS_HOST=127.0.0.1
PRAXIS_PORT=8000
PRAXIS_LOG_LEVEL=INFO
