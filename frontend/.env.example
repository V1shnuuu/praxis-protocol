# ---------------------------------------------------------------------------
# Praxis Protocol — dashboard (/frontend/.env.local)
# Every value here is public: it is inlined into the client bundle.
# ---------------------------------------------------------------------------

# FastAPI orchestrator base URL. LEAVE THIS UNSET to run the dashboard in
# demo mode, which drives the full rogue -> dispute -> slash story from an
# in-browser simulation with no backend required.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# How often (ms) the dashboard re-polls the backend for new attestations.
NEXT_PUBLIC_POLL_INTERVAL_MS=4000

# Canonical origin used for Open Graph and canonical URLs. Defaults to the
# deployed Vercel host; set this if you serve the dashboard from another domain.
# NEXT_PUBLIC_SITE_URL=https://praxis-protocol-zeta.vercel.app

# Read-only RPC used for the on-chain verification panel and wallet connect.
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com
