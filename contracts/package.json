{
  "name": "praxis-contracts",
  "version": "1.0.0",
  "description": "Praxis Protocol smart contracts - on-chain accountability for autonomous AI agents",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:localhost": "hardhat run scripts/deploy.js --network localhost",
    "fund:localhost": "hardhat run scripts/fund.js --network localhost",
    "demo:local": "hardhat run scripts/demo-flow.js",
    "demo:localhost": "hardhat run scripts/demo-flow.js --network localhost",
    "wallets:new": "hardhat run scripts/new-wallets.js",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "fund:amoy": "hardhat run scripts/fund.js --network amoy",
    "demo:amoy": "hardhat run scripts/demo-flow.js --network amoy",
    "verify:amoy": "hardhat run scripts/verify.js --network amoy",
    "verify:localhost": "hardhat run scripts/verify.js --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.17",
    "dotenv": "^16.4.7",
    "solc": "0.8.24"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
