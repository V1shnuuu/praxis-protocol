# ---------------------------------------------------------------------------
# Praxis Protocol — contracts (/contracts/.env)
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Polygon Amoy RPC. The public endpoint works but is rate-limited; an Alchemy or
# Infura Amoy URL is more reliable for a live demo.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deploying account, WITHOUT the 0x prefix is also accepted by
# ethers, but include 0x for clarity. Fund it with test POL from
# https://faucet.polygon.technology (select Polygon Amoy).
DEPLOYER_PRIVATE_KEY=0xyour_test_private_key_here

# The demo flow uses three separate roles so it mirrors the real trust model.
# `npm run wallets:new` generates the two below; `npm run fund:amoy` tops them up
# with POL and PRAX from the deployer. Both are optional for deployment.
#   AGENT      — owns the registered agents (the backend orchestrator signs as this key)
#   CHALLENGER — the watcher that stakes a fee to open disputes
AGENT_PRIVATE_KEY=
CHALLENGER_PRIVATE_KEY=

# Optional: used by `npm run verify:amoy` for PolygonScan source verification.
POLYGONSCAN_API_KEY=

# Optional deployment parameters (sensible defaults are used if unset).
# Address that resolves disputes. Defaults to the deployer.
ARBITER_ADDRESS=
# Address that receives the protocol share of slashed bonds. Defaults to the deployer.
TREASURY_ADDRESS=
# Minimum bond an agent must post, in whole PRAX tokens.
MIN_BOND=1000
# Challenge window in seconds. 300 (5 min) keeps live demos fast.
CHALLENGE_WINDOW_SECONDS=300
# Fee to open a dispute, in whole PRAX tokens.
CHALLENGE_FEE=100
# Share of the agent's remaining bond slashed when a dispute is upheld (bps).
SLASH_BPS=2000
# Share of the slashed amount paid to the challenger (bps).
CHALLENGER_REWARD_BPS=5000

REPORT_GAS=false
